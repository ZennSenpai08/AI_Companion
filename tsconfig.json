{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "frontend/src/**/*.ts",
    "frontend/src/**/*.vue",
    "vite.config.ts",
    "frontend/src/services/**/*.mjs"
  ]
}
