{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "electron/**/*.cjs",
    "scripts/*.cjs",
    "scripts/native-probe/*.cjs",
    "scripts/visible-native-probe/*.cjs"
  ]
}
